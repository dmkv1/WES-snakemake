# Every /path/to/... below is a placeholder. Repoint them before the
# first run. Each reference and PON path must sit under refs.path or
# panel_of_normals.path, because the Snakefile builds the container bind mounts
# from exactly those two roots.
samplesheet: "samplesheet.csv"
telegram_bot_env: ""  # Path to .telegram_bot.env file; leave empty to disable notifications
run_id: ""            # Human-readable label prepended to Telegram notifications, e.g. "missing_models"

# Container images
containers:
  gatk: "docker://broadinstitute/gatk:4.6.2.0"
  vep: "docker://ensemblorg/ensembl-vep:release_116.0"
  cnvkit: "docker://etal/cnvkit:0.9.14"
  delly: "docker://dellytools/delly:v2.5.1"

# Each probe type points at the original Agilent kit BED files (header lines and
# all; GATK tools and mosdepth skip browser/track, index_bed strips them):
#   covered_bedfile        — the "Covered" BED (probe regions). Primary interval
#                            set: BQSR --intervals, mosdepth, Mutect2 intervals.
#                            Matches the WES-PON-smk covered_bedfile.
#   target_regions_bedfile — the "Regions" BED, used as the HsMetrics TARGET
#                            interval list (covered_bedfile is the BAIT set).
probe_configs:
  "V6+UTR":
    covered_bedfile:        "/path/to/refs/SureSelectHumanAllExon/V6UTR/S07604624_Covered.bed"
    target_regions_bedfile: "/path/to/refs/SureSelectHumanAllExon/V6UTR/S07604624_Regions.bed"
    cnvkit_targets:     "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV6UTR/targets.bed"
    cnvkit_antitargets: "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV6UTR/antitargets.bed"
  "V8+UTR":
    covered_bedfile:        "/path/to/refs/SureSelectHumanAllExon/V8UTR/S33613271_Covered.bed"
    target_regions_bedfile: "/path/to/refs/SureSelectHumanAllExon/V8UTR/S33613271_Regions.bed"
    cnvkit_targets:     "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV8UTR/targets.bed"
    cnvkit_antitargets: "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV8UTR/antitargets.bed"

refs:
  # Absolute paths to reference directory:
  path: "/path/to/refs"
  # Absolute paths to reference files:
  ## Genomes
  genome_human: "/path/to/refs/broad/Homo_sapiens_assembly38.fasta"
  genome_host: "/path/to/refs/mm39/mm39.fa"
  ## BQSR
  known_sites:
    - "/path/to/refs/broad/Homo_sapiens_assembly38.dbsnp138.vcf"
    - "/path/to/refs/broad/Homo_sapiens_assembly38.known_indels.vcf.gz"
    - "/path/to/refs/broad/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
  ## Mutect2
  germline_resource: "/path/to/refs/gatk-BP-somatic-hg38/af-only-gnomad.hg38.vcf.gz"
  ## Contamination (GetPileupSummaries / CalculateContamination)
  contamination_resource: "/path/to/refs/gatk-BP-somatic-hg38/small_exac_common_3.hg38.vcf.gz"
  ## VEP cache (INSTALL.pl --CACHEDIR is the parent dir; VEP resolves
  ## <dir_cache>/<species>/<cache_version>_<assembly> itself)
  vep_cache:
    dir: "/path/to/refs/vep_cache/GRCh38"
    species: "homo_sapiens"
    assembly: "GRCh38"
    cache_version: 116
  ## Predownloaded AnnotSV cache
  annotsv_annotations:
    genome_build: "GRCh38"
    path: "/path/to/refs/annotsv/AnnotSV_annotations"
  purecn:
    genome: "hg38"
    # UCSC Simple Repeats (Tandem Repeats Finder) track, hg38. See README
    # "Reference files" section for sourcing.
    snp_blacklist: "/path/to/refs/UCSC/hg38_simpleRepeats.bed"
  ## Somalier (sample-swap / sex QC)
  somalier_sites: "/path/to/refs/somalier/sites.hg38.vcf.gz"

params:
    rg:
      # Read-group resolution: how to treat a samplesheet that contradicts the
      # data (flowcell, or a lane that disagrees with the filename or the
      # reads). true stops the run, which is right when an operator curates the
      # sheet and can fix it. false records a warning and carries on, which is
      # right for unattended deployments where a degraded read group beats no
      # result. Provenance is reported per unit either way, as rg_source in
      # results/metadata/units.tsv and the MultiQC report.
      strict: true
    xengsort:
      index_size: 4500000000
      index_fill: 0.88
      index_k: 25
      chunksize: 16.0
      prefetch: 1
    cnvkit:
      filter_ci: false  # Set to true to enable segments filtering based on CI
    cnv:
      # Purity/ploidy for cnvkit_call, resolved per tumor by
      # resolve_purity_source (purecn.smk) in priority: (1) samplesheet
      # tumor_fraction when known; (2) PureCN's estimate if it ran, didn't fail,
      # and its ONLY flag is POOR GOF; (3) else assume pure (purity 1).
      # use_purecn_purity=false disables step 2 (known-or-assume-pure only), the
      # rollback path. PureCN still runs regardless, so its numbers stay in the
      # report for comparison even when unused.
      use_purecn_purity: true
    fastp:
      # adds sequence-based PE adapter detection as a backstop to R1/R2 overlap analysis
      detect_adapter_for_pe: true
    bqsr:
      interval_padding: 100
    delly:
      # DELLY short-read recommendations (per the DELLY author): exclude
      # telomeres/centromeres/unplaced contigs and filter input reads stringently.
      # DELLY is the confirmatory caller in the Manta consensus, so favour
      # precision. Leave exclude empty to omit -x. See README "Reference files"
      # for sourcing the hg38 exclude template.
      exclude: "/path/to/refs/delly/human.hg38.excl.tsv"
      map_qual: 20        # -q  min. paired-end mapping quality (default 1)
      mad_cutoff: 15      # -s  insert-size MAD cutoff, deletions only (default 9)
      min_clique_size: 5  # -z  min. PE/SR clique size; raise for high-coverage (default 2)
      # SURVIVOR merge of Manta + DELLY SV calls (consensus).
      survivor_max_dist: 1000  # max breakpoint distance (bp) to call two SVs the same
      survivor_min_size: 0     # min SV size to keep in the merge (0 = no size filter)
      # AnnotSV's own -SVminSize, applied after the merge (DEL/DUP/INS only; INV
      # and TRA/BND are not size-gated here). AnnotSV defaults this to 50bp and
      # silently drops anything smaller with no warning in the log. 1 matches the
      # "no minimum" intent of survivor_min_size above.
      annotsv_min_size: 1
      # Drop megabase intra-chromosomal SVs from the consensus before annotation:
      # WES SV callers (esp. DELLY off-target split/PE reads) produce spurious
      # multi-Mb INV/DUP that span hundreds of genes; large CNVs are covered by
      # CNVkit. Translocations (BND) are never size-filtered. 0 disables the cap.
      max_sv_size: 3000000
    somalier:
      # Relatedness/swap QC thresholds (report-only, no DAG gating). Applied by
      # somalier_summarise over the cohort pairs table. Defaults tuned to
      # observed within-patient spread (LOH/aneuploidy depress relatedness, but
      # ibs0 stays ~0 within an individual; a true swap drives ibs0 up).
      ibs0_frac_max: 0.005     # within-patient FAIL when ibs0/n exceeds this
      relatedness_warn: 0.85   # within-patient WARN when relatedness below this
      unrelated_max: 0.30      # cross-patient FAIL when relatedness exceeds this

# Built by WES-PON-smk from all current normals, per capture kit.
panel_of_normals:
  path: "/path/to/WES-PON-smk"
  cnvkit:
    cnvkit_ref_m:
      "V6+UTR": "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV6UTR/reference_m.cnn"
      "V8+UTR": "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV8UTR/reference_m.cnn"
    cnvkit_ref_f:
      "V6+UTR": "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV6UTR/reference_f.cnn"
      "V8+UTR": "/path/to/WES-PON-smk/results/PON/cnvkit/SureSelectV8UTR/reference_f.cnn"
  mutect2:
    "V6+UTR": "/path/to/WES-PON-smk/results/PON/mutect2/SureSelectV6UTR/pon.vcf.gz"
    "V8+UTR": "/path/to/WES-PON-smk/results/PON/mutect2/SureSelectV8UTR/pon.vcf.gz"
  purecn:
    normaldb_m:
      "V6+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV6UTR/normalDB_SureSelectV6UTR_m_hg38.rds"
      "V8+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV8UTR/normalDB_SureSelectV8UTR_m_hg38.rds"
    normaldb_f:
      "V6+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV6UTR/normalDB_SureSelectV6UTR_f_hg38.rds"
      "V8+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV8UTR/normalDB_SureSelectV8UTR_f_hg38.rds"
    mapping_bias_m:
      "V6+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV6UTR/mapping_bias_SureSelectV6UTR_m_hg38.rds"
      "V8+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV8UTR/mapping_bias_SureSelectV8UTR_m_hg38.rds"
    mapping_bias_f:
      "V6+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV6UTR/mapping_bias_SureSelectV6UTR_f_hg38.rds"
      "V8+UTR": "/path/to/WES-PON-smk/results/PON/purecn/SureSelectV8UTR/mapping_bias_SureSelectV8UTR_f_hg38.rds"

tumor_only:
  af_threshold: 0.001  # Filter variants with population AF > this

# Scale every value below with the machine. Also scale cores, resources.mem_mb
# and resources.io_heavy in profiles/default/config.yaml.
# Each GATK tier reserves its heap plus 25 percent for non-heap memory. A heavy
# job holds 40 GB, and 32 GB of that is heap. The MarkDuplicates tier holds
# 30 GB, a medium job holds 20 GB, and a light job holds 10 GB.
resources:
  threads: 16
  # Ceilings for the tools that stop scaling before `threads`. Snakemake lowers
  # each one to the cores the host actually has, so these do not need editing
  # for a smaller machine.
  mutect2_threads: 8
  haplotypecaller_threads: 12
  manta_threads: 8
  vep_threads: 4
  delly_mem_mb: 4096
  sort_mem: "1G"

  # GATK memory tiers. Each tier is a JVM heap window plus the mem_mb the
  # scheduler reserves against the profile budget: the heap ceiling plus 25%
  # non-heap overhead. java_min_gb starts small; the JVM grows to java_max_gb on
  # demand. The figures are absolute and do not scale with threads.
  #
  # A tier ceiling is roughly 2.5x the max_rss its rules recorded in
  # work/benchmarks/<rule>/*.tsv on a 9 GB WES BAM. A JVM only grows to what it
  # needs, so the measured peak, not the ceiling it was given, is what a rule
  # actually costs; sizing off the ceiling made every per-sample stage reserve
  # the largest figure and throttled the run to a handful of concurrent jobs.
  # After a cohort at different coverage, re-read the benchmarks and move a rule
  # between tiers rather than widening a tier.
  gatk:
    # BedToIntervalList, CollectHsMetrics, BaseRecalibrator, ApplyBQSR,
    # GetPileupSummaries, CalculateContamination, FilterMutectCalls,
    # CollectAllelicCounts. Measured 1-3 GB.
    light:
      java_min_gb: 2
      java_max_gb: 8
      mem_mb: 10240
    # HaplotypeCaller, 4 GB measured, and LearnReadOrientationModel, 3 GB, which
    # reads every f1r2 tar of a sample into memory at once.
    medium:
      java_min_gb: 4
      java_max_gb: 12
      mem_mb: 15360
    # MarkDuplicates measured 15 GB on a 9 GB WES BAM against a 16 GB ceiling,
    # so it is the one rule whose true demand the benchmark did not bound. The
    # peak tracks the duplicate-set index, which grows with library complexity,
    # so it keeps a heap window of its own, wider than the 2.5x rule.
    markdup:
      java_min_gb: 4
      java_max_gb: 24
      mem_mb: 30720
    # Mutect2, which holds the active-region assembly graphs for a paired
    # tumor/normal WES pair across every worker thread. Measured 6 GB over a
    # two-hour paired call.
    heavy:
      java_min_gb: 8
      java_max_gb: 16
      mem_mb: 20480
  # Manta parcels the call out to its own task scheduler under --jobs and holds
  # under 1 GB in the parent process, so --memGb is a ceiling for that scheduler
  # rather than a heap it fills. manta_max_gb stays at or under 0.8 of
  # manta_mem_mb, the same ratio the GATK tiers hold.
  manta_max_gb: 6
  manta_mem_mb: 8192

  xengsort_mem_mb: 32768
  xengsort_index_mem_mb: 32768
